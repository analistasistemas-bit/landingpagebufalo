---
// StitchDivider.astro — Section divider whose scissors follow the visitor's scroll.

interface Props {
  color?: string;
  ornament?: boolean;
}

const { color = 'var(--bufalo-vermelho)', ornament = true } = Astro.props;
---

<div
  class="stitch-divider"
  style={`--stitch-color:${color}`}
  data-has-ornament={String(ornament)}
  aria-hidden="true"
>
  <div class="stitch-divider__line"></div>
  {ornament && (
    <div class="stitch-divider__ornament">
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
        <circle cx="4" cy="4" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <circle cx="4" cy="10" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <line class="stitch-divider__blade stitch-divider__blade--top" x1="6.5" y1="5.5" x2="19" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line class="stitch-divider__blade stitch-divider__blade--bottom" x1="6.5" y1="8.5" x2="19" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </div>
  )}
</div>

<style>
  .stitch-divider {
    display: flex;
    align-items: center;
    padding-block: 0.25rem;
    min-height: 1.5rem;
    box-sizing: border-box;
    width: 100%;
    color: var(--stitch-color, var(--bufalo-vermelho));
    position: relative;
    overflow: clip;
  }

  .stitch-divider__line {
    flex: 1;
    height: 0;
    border-top: 2px dashed var(--stitch-color, var(--bufalo-vermelho));
    opacity: 0.4;
  }

  .stitch-divider[data-has-ornament='true'] .stitch-divider__line {
    margin-right: 2.75rem;
  }

  .stitch-divider__ornament {
    position: absolute;
    right: 0;
    top: 50%;
    width: 2.75rem;
    padding-inline: 0.75rem;
    box-sizing: border-box;
    opacity: 0.7;
    color: var(--stitch-color, var(--bufalo-vermelho));
    transform: translateY(-50%);
  }

  .stitch-divider__ornament svg {
    display: block;
  }

  .stitch-divider__blade {
    transform-box: view-box;
    transform-origin: 19px 7px;
  }

  .stitch-divider[data-scroll-motion='true'] .stitch-divider__line {
    clip-path: inset(0 var(--line-conceal, 100%) 0 0);
  }

  .stitch-divider[data-scroll-motion='true'] .stitch-divider__ornament {
    right: auto;
    left: 0;
    transform: translate3d(var(--scissor-x, 0), -50%, 0);
    will-change: transform;
  }

  .stitch-divider[data-scroll-motion='true'] .stitch-divider__blade--top {
    transform: rotate(var(--blade-top-angle, 0deg));
  }

  .stitch-divider[data-scroll-motion='true'] .stitch-divider__blade--bottom {
    transform: rotate(var(--blade-bottom-angle, 0deg));
  }
</style>

<script>
  const mq = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (mq.matches) {
    const dividers = Array.from(
      document.querySelectorAll<HTMLElement>('.stitch-divider[data-has-ornament="true"]')
    );
    let frame = 0;

    const clamp = (value: number) => Math.min(1, Math.max(0, value));

    const updateDividers = () => {
      const viewportHeight = window.innerHeight;
      const start = viewportHeight * 0.92;
      const end = viewportHeight * 0.52;

      dividers.forEach((divider) => {
        const ornament = divider.querySelector<HTMLElement>('.stitch-divider__ornament');
        if (!ornament) return;

        const progress = clamp((start - divider.getBoundingClientRect().top) / (start - end));
        const travel = Math.max(0, divider.clientWidth - ornament.offsetWidth);
        const bladeAngle = Math.abs(Math.sin(progress * Math.PI * 3)) * 3;

        divider.dataset.cutProgress = progress.toFixed(3);
        divider.style.setProperty('--line-conceal', `${((1 - progress) * 100).toFixed(2)}%`);
        divider.style.setProperty('--scissor-x', `${(travel * progress).toFixed(2)}px`);
        divider.style.setProperty('--blade-top-angle', `${(-bladeAngle).toFixed(2)}deg`);
        divider.style.setProperty('--blade-bottom-angle', `${bladeAngle.toFixed(2)}deg`);
      });

      frame = 0;
    };

    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateDividers);
    };

    dividers.forEach((divider) => {
      divider.dataset.scrollMotion = 'true';
    });

    updateDividers();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  }
</script>
