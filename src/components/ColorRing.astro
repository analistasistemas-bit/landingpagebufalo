---
// ColorRing.astro — Hero signature: colored dots in a ring with center medallion.
// Vivid, evenly-spaced HSL spectrum (the approved concept). The real/authentic
// catalog colors live in ColorSwatches (Linha 120 cartela), not here.
// Dots computed at build time (no client JS). Animation respects prefers-reduced-motion.

interface Props {
  dotCount?: number;
  label?: string;
  sublabel?: string;
}

const {
  dotCount = 24,
  label = '100+',
  sublabel = 'CORES',
} = Astro.props;

// Vivid spectrum: evenly-spaced hues, high saturation — a clean rainbow ring.
const dots = Array.from({ length: dotCount }, (_, i) => {
  const angle = (i / dotCount) * 2 * Math.PI - Math.PI / 2; // start top
  const rx = 43; // % from center
  const ry = 43;
  const cx = 50 + rx * Math.cos(angle);
  const cy = 50 + ry * Math.sin(angle);
  const hue = Math.round((i / dotCount) * 360);
  const color = `hsl(${hue}, 78%, 52%)`;
  const depth = 18 + (i % 3) * 3;
  return { cx, cy, color, depth, delay: 180 + i * 12 };
});
---

<div class="color-ring" data-color-ring role="img" aria-label={`Anel de ${dotCount} cores — ${label} ${sublabel}`}>
  <div class="color-ring__track" data-color-ring-track>
    <div class="color-ring__orbit" aria-hidden="true">
      {dots.map((dot) => (
        <span
          class="color-ring__dot"
          style={`left:${dot.cx}%;top:${dot.cy}%;--dot-color:${dot.color};--dot-depth:${dot.depth}px;--delay:${dot.delay}ms`}
        />
      ))}
    </div>
    <div class="color-ring__medallion" aria-hidden="true">
      <span class="color-ring__label">{label}</span>
      <span class="color-ring__sublabel">{sublabel}</span>
    </div>
  </div>
</div>

<style>
  .color-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(280px, 70vw, 400px);
    aspect-ratio: 1;
    flex-shrink: 0;
    overflow: clip;
    perspective: 900px;
  }

  .color-ring__track {
    position: relative;
    width: 100%;
    height: 100%;
    transform: rotateX(9deg) rotateZ(-2deg);
    transform-style: preserve-3d;
  }

  .color-ring__orbit {
    inset: 0;
    position: absolute;
    transform: rotateZ(0deg);
    transform-style: preserve-3d;
  }

  /* Dots */
  .color-ring__dot {
    position: absolute;
    width: clamp(16px, 4vw, 24px);
    height: clamp(16px, 4vw, 24px);
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 32% 26%,
        color-mix(in srgb, var(--dot-color), var(--bufalo-branco) 88%) 0 7%,
        color-mix(in srgb, var(--dot-color), var(--bufalo-branco) 36%) 8% 24%,
        transparent 43%
      ),
      var(--dot-color);
    box-shadow:
      inset -4px -6px 8px color-mix(in srgb, var(--dot-color), var(--bufalo-cinza) 26%),
      inset 3px 3px 6px color-mix(in srgb, var(--dot-color), var(--bufalo-branco) 68%),
      0 9px 14px -7px color-mix(in srgb, var(--bufalo-cinza), transparent 68%);
    transform: translate3d(-50%, -50%, var(--dot-depth));
    transform-style: preserve-3d;
  }

  /* Center medallion */
  .color-ring__medallion {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 8px);

    width: 44%;
    height: 44%;
    border-radius: 50%;

    background:
      radial-gradient(
        circle at 35% 28%,
        color-mix(in srgb, var(--bufalo-vermelho), var(--bufalo-branco) 12%),
        var(--bufalo-vermelho) 54%,
        color-mix(in srgb, var(--bufalo-vermelho), var(--bufalo-cinza) 24%)
      );
    color: var(--bufalo-branco);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    border: 3px solid var(--bufalo-branco);
    outline: 3px solid var(--bufalo-vermelho);
    outline-offset: 2px;
    box-shadow:
      inset -12px -16px 24px color-mix(in srgb, var(--bufalo-vermelho), var(--bufalo-cinza) 28%),
      inset 8px 9px 18px color-mix(in srgb, var(--bufalo-vermelho), var(--bufalo-branco) 18%),
      0 18px 30px -14px color-mix(in srgb, var(--bufalo-vermelho), transparent 46%);
    transform-style: preserve-3d;
  }

  .color-ring__label {
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: clamp(1.1rem, 3.5vw, 1.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .color-ring__sublabel {
    font-family: var(--font-titulo);
    font-weight: 600;
    font-size: clamp(0.5rem, 1.5vw, 0.75rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 2px;
    opacity: 0.9;
  }

  /* One composed entrance; the default state remains fully visible. */
  @media (prefers-reduced-motion: no-preference) {
    .color-ring__track {
      animation: ring-arrive 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .color-ring__orbit {
      animation: palette-orbit 18s 900ms linear infinite;
      animation-play-state: paused;
    }

    .color-ring[data-orbit-active='true'] .color-ring__orbit {
      animation-play-state: running;
    }

    .color-ring__dot {
      animation: color-chip-settle 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--delay);
    }

    .color-ring__medallion {
      animation: medallion-settle 620ms 80ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes ring-arrive {
      from {
        transform: rotateX(17deg) rotateY(-7deg) rotateZ(-8deg) scale(0.96);
      }

      to {
        transform: rotateX(9deg) rotateY(0) rotateZ(-2deg) scale(1);
      }
    }

    @keyframes color-chip-settle {
      from {
        opacity: 0.25;
        transform: translate3d(-50%, -50%, 2px) scale(0.72);
      }

      to {
        opacity: 1;
        transform: translate3d(-50%, -50%, var(--dot-depth)) scale(1);
      }
    }

    @keyframes palette-orbit {
      to {
        transform: rotateZ(360deg);
      }
    }

    @keyframes medallion-settle {
      from {
        opacity: 0.72;
        transform: translate3d(-50%, -50%, 2px) scale(0.94);
      }

      to {
        opacity: 1;
        transform: translate3d(-50%, -50%, 8px) scale(1);
      }
    }
  }
</style>

<script>
  const rings = document.querySelectorAll<HTMLElement>('[data-color-ring]');

  const syncOrbit = (ring: HTMLElement) => {
    ring.dataset.orbitActive = String(ring.dataset.orbitVisible === 'true' && !document.hidden);
  };

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      const ring = entry.target as HTMLElement;
      ring.dataset.orbitVisible = String(entry.isIntersecting);
      syncOrbit(ring);
    }
  }, { threshold: 0.15 });

  rings.forEach((ring) => observer.observe(ring));
  document.addEventListener('visibilitychange', () => rings.forEach(syncOrbit));
</script>
