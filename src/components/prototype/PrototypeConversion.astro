---
import { waLink, waMsg } from '../../data/whatsapp';
---

<section id="contato" class="prototype-conversion" aria-labelledby="conversion-title">
  <div class="container">
    <h2 id="conversion-title">Pronto para trabalhar com a força da Búfalo?</h2>
    <div class="prototype-conversion__actions">
      <a class="btn btn--ghost-white" href={waLink(waMsg.atacado)} target="_blank" rel="noopener noreferrer">Comprar em volume</a>
      <a class="btn btn--ghost-white" href={waLink(waMsg.revendedor)} target="_blank" rel="noopener noreferrer">Quero ser revendedor</a>
    </div>
  </div>
</section>

<style>
  .prototype-conversion {
    background: var(--bufalo-vermelho);
    color: var(--bufalo-branco);
    text-align: center;
  }

  .prototype-conversion h2 {
    margin-inline: auto;
    max-width: 36rem;
  }

  .prototype-conversion__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .prototype-conversion__actions :global(.btn) {
    min-height: 44px;
    min-width: 44px;
  }

  @media (min-width: 640px) {
    .prototype-conversion__actions {
      align-items: center;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prototype-conversion__actions :global(.btn) {
      transition: none;
    }
  }
</style>
