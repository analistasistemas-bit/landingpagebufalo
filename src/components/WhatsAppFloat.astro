---
import { waLink } from '../data/whatsapp';
import WhatsAppIcon from './WhatsAppIcon.astro';

const waHref = waLink();
---

<a
  href={waHref}
  class="wa-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Fale conosco no WhatsApp"
  title="Fale conosco"
>
  <WhatsAppIcon size={28} />
  <span class="wa-float__tooltip">Fale conosco</span>
</a>

<style>
  .wa-float {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 200;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 58px;
    height: 58px;
    border-radius: 50%;

    background-color: #25d366;
    color: #fff;
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
    text-decoration: none;

    /* Entrance animation */
    animation: wa-entrance 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1s both;
  }

  .wa-float:hover {
    background-color: #1ebe5d;
    text-decoration: none;
    transform: scale(1.08);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .wa-float:focus-visible {
    outline: 3px solid #25d366;
    outline-offset: 3px;
  }

  /* Tooltip */
  .wa-float__tooltip {
    position: absolute;
    right: calc(100% + 0.75rem);
    top: 50%;
    transform: translateY(-50%);

    background-color: rgba(0, 0, 0, 0.75);
    color: #fff;
    font-family: var(--font-corpo);
    font-size: 0.8rem;
    white-space: nowrap;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;

    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .wa-float:hover .wa-float__tooltip,
  .wa-float:focus-visible .wa-float__tooltip {
    opacity: 1;
  }

  /* Pulse ring (idle) */
  .wa-float::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #25d366;
    opacity: 0;
    animation: wa-pulse 2.5s ease-out 2s infinite;
  }

  /* Entrance */
  @keyframes wa-entrance {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Pulse ring */
  @keyframes wa-pulse {
    0%   { opacity: 0.6; transform: scale(1); }
    100% { opacity: 0;   transform: scale(1.5); }
  }

  /* Respect prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      animation: none;
    }
    .wa-float::after {
      animation: none;
    }
  }
</style>
