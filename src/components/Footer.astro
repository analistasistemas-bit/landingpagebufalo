---
import { waLink, waDisplay } from '../data/whatsapp';
import { navLinks } from '../data/nav';
import config from '../data/config.json';
import InstagramIcon from './InstagramIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const waHref = waLink();
const instagramHref = config.redes.instagram;
---

<footer class="site-footer">
  <div class="container footer-inner">

    <!-- Col 1: Logo + tagline -->
    <div class="footer-col footer-brand">
      <a href="/" aria-label="Búfalo — página inicial">
        <img
          src="/images/logos/logo-branca.png"
          alt="Búfalo - Força e Qualidade"
          height="52"
          width="auto"
          loading="lazy"
        />
      </a>
      <p class="footer-tagline">Búfalo · Força e Qualidade</p>
      <p class="footer-desc">
        Linhas de costura e aviamentos de alta resistência. Presente em todo o Brasil.
      </p>
    </div>

    <!-- Col 2: Contato -->
    <div class="footer-col">
      <h3 class="footer-heading">Contato</h3>
      <ul class="footer-list">
        <li>
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link footer-link--contact footer-link--wa"
            aria-label={`WhatsApp ${waDisplay()}`}
          >
            <WhatsAppIcon size={16} />
            {waDisplay()}
          </a>
        </li>
        <li>
          <a
            href={instagramHref}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link footer-link--contact footer-link--instagram"
            aria-label="Instagram da Búfalo — @marcabufalo"
          >
            <InstagramIcon size={18} />
            @marcabufalo
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 3: Links rápidos -->
    <div class="footer-col">
      <h3 class="footer-heading">Navegação</h3>
      <ul class="footer-list">
        {navLinks.map(({ label, href }) => (
          <li>
            <a href={href} class="footer-link">{label}</a>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container">
      <p>© 2026 Linhas Búfalo · Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bufalo-bordo);
    color: var(--bufalo-branco);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 3rem;
    padding-block: 3.5rem;
  }

  .footer-brand .footer-tagline {
    margin-top: 1rem;
    font-family: var(--font-titulo);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .footer-desc {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .footer-heading {
    font-family: var(--font-titulo);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 1rem;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-link:hover {
    color: var(--bufalo-branco);
    text-decoration: none;
  }

  .footer-link--wa {
    color: #4ade80; /* green-400 — visible on dark background */
  }

  .footer-link--wa:hover {
    color: #86efac;
  }

  .footer-link--contact {
    min-height: 44px;
    min-width: 44px;
    padding-block: 0.5rem;
  }

  .footer-link--instagram {
    color: var(--bufalo-branco);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-block: 1.25rem;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
    text-align: center;
    margin: 0;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* Mobile */
  @media (max-width: 540px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 2.5rem;
    }
  }
</style>
