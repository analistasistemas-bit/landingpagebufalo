---
import { waLink } from '../data/whatsapp';
import { navLinks } from '../data/nav';
import WhatsAppIcon from './WhatsAppIcon.astro';

const currentPath = Astro.url.pathname;
const waHref = waLink();
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Logo -->
    <a href="/" class="header-logo" aria-label="Búfalo — página inicial">
      <img
        src="/images/logos/logo-header.png"
        alt="Búfalo - Força e Qualidade"
        height="52"
        width="auto"
        loading="eager"
      />
    </a>

    <!-- Nav principal (desktop) -->
    <nav
      class="header-nav"
      id="header-nav"
      aria-label="Navegação principal"
    >
      <ul role="list">
        {navLinks.map(({ label, href }) => {
          const isActive =
            href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(href);
          return (
            <li>
              <a
                href={href}
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- CTA WhatsApp -->
    <a
      href={waHref}
      class="btn btn--primary header-cta"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Fale conosco no WhatsApp"
    >
      <WhatsAppIcon size={18} />
      WhatsApp
    </a>

    <!-- Hamburger (mobile) -->
    <button
      class="hamburger"
      id="hamburger"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      aria-controls="header-nav"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger') as HTMLButtonElement;
  const nav = document.getElementById('header-nav') as HTMLElement;
  const header = document.getElementById('site-header') as HTMLElement;

  // Toggle mobile menu
  hamburger?.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('is-open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    hamburger.setAttribute(
      'aria-label',
      isOpen ? 'Fechar menu de navegação' : 'Abrir menu de navegação'
    );
  });

  // Close menu on nav link click (mobile)
  nav?.querySelectorAll('.nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'Abrir menu de navegação');
    });
  });

  // Shadow on scroll
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 4);
  }, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--bufalo-branco);
    transition: box-shadow 0.2s ease;
  }

  .site-header.scrolled {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 76px;
  }

  .header-logo img {
    height: 52px;
    width: auto;
    display: block;
  }

  /* Desktop nav */
  .header-nav ul {
    display: flex;
    list-style: none;
    gap: 0.25rem;
    align-items: center;
  }

  .nav-link {
    display: block;
    padding: 0.4rem 0.65rem;
    font-family: var(--font-titulo);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bufalo-cinza);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--bufalo-vermelho);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--bufalo-vermelho);
    border-bottom-color: var(--bufalo-vermelho);
  }

  /* CTA button */
  .header-cta {
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--bufalo-cinza);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    .header-cta {
      display: none;
    }

    .header-nav {
      display: none;
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      background-color: var(--bufalo-branco);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      padding: 1rem 0 1.5rem;
    }

    .header-nav.is-open {
      display: block;
    }

    .header-nav ul {
      flex-direction: column;
      gap: 0;
      align-items: stretch;
    }

    .nav-link {
      padding: 0.85rem 1.5rem;
      font-size: 1rem;
      border-bottom: none;
      border-left: 3px solid transparent;
    }

    .nav-link:hover,
    .nav-link.active {
      background-color: var(--bufalo-cinza-claro);
      border-left-color: var(--bufalo-vermelho);
    }
  }

  /* Ensure header space for sticky */
  :global(body) {
    padding-top: 76px;
  }
</style>
